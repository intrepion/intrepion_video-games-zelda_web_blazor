<h1>@Mode EmulatorCore</h1>

<hr />
@if (EmulatorCore is not null)
{
    <EditForm Model="EmulatorCore" OnInvalidSubmit="(async () => await HandleSubmitAsync(false))" OnValidSubmit="(async () => await HandleSubmitAsync(true))">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h2>Emulator</h2>
        <p>
            <label>
                Emulator:
                <InputSelect @bind-Value="SelectedEmulatorId" @oninput="HandleEmulatorChange" class="form-select">
                    <option value="">-- Select Emulator --</option>
                    @foreach (var emulator in EmulatorList)
                    {
                        <option value="@emulator.Id">@emulator?.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        <div class="mb-3">
            <label class="form-label">Is Test?:
                <InputCheckbox @bind-Value="EmulatorCore.IsTest" @oninput="HandleIsTestChange" class="form-check-input"/>
            </label>
        </div>
        <div class="mb-3">
            <label class="form-label">Name:
                <InputText @bind-Value="EmulatorCore.Name" @oninput="HandleNameChange" class="form-control"/>
            </label>
        </div>
        @* PropertyFormCodePlaceholder *@

        <button type="button" disabled="@Busy" class="btn btn-warning" @onclick="CancelAsync">
            Cancel
        </button>&nbsp;
        <button disabled="@Busy" type="submit" class="btn btn-primary">
            Submit
        </button>
    </EditForm>
}

@code {
    [Parameter]
    public EventCallback<bool> ValidationResult { get; set; }

    [Parameter]
    public EventCallback CancelRequest { get; set; }

    [Parameter]
    public bool IsAdd { get; set; }

    [Parameter]
    public EmulatorCore? EmulatorCore { get; set; }

    [Parameter]
    public EmulatorCore? DbEmulatorCore { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    private string Mode => IsAdd ? "Add" : "Edit";

    [Parameter]
    public List<Emulator> EmulatorList { get; set; } = new List<Emulator>();
    private Guid SelectedEmulatorId;
    @* DeclareListCodePlaceholder *@

    protected override void OnInitialized()
    {
        if (EmulatorCore?.Emulator != null && !IsAdd)
        {
            SelectedEmulatorId = EmulatorCore.Emulator.Id;
        }
        @* OnInitialCodePlaceholder *@
        @* if (EmulatorCore?.Emulator != null && !IsAdd)
        {
            SelectedEmulatorId = EmulatorCore.Emulator.Id;
        } *@
    }

    private async Task CancelAsync() => await CancelRequest.InvokeAsync(null);

    private async Task HandleSubmitAsync(bool isValid) => await ValidationResult.InvokeAsync(isValid);

    private void HandleEmulatorChange(ChangeEventArgs changeEventArgs)
    {
        if (EmulatorCore == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        if (changeEventArgs.Value is string value && Guid.TryParse(value, out Guid selectedEmulatorId))
        {
            SelectedEmulatorId = selectedEmulatorId;
            var selectedEmulator = EmulatorList.FirstOrDefault(x => x.Id == SelectedEmulatorId);

            if (selectedEmulator != null)
            {
                EmulatorCore.Emulator = selectedEmulator;
            }
        }

        // SpecializedCodeEmulatorPlaceholder
    }

    private void HandleIsTestChange(ChangeEventArgs changeEventArgs)
    {
        // SpecializedCodeIsTestPlaceholder
    }

    private void HandleNameChange(ChangeEventArgs changeEventArgs)
    {
        if (EmulatorCore == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        EmulatorCore.NormalizedName = ((string)changeEventArgs.Value).ToUpperInvariant();

        // SpecializedCodeNamePlaceholder
    }

    // HandleChangeCodePlaceholder
}
