@page "/admin/emulator-core/add"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Emulator Core Add</PageTitle>

@if (EmulatorCore is not null)
{
  <EmulatorCoreForm Busy="Busy" 
         EmulatorCore="EmulatorCore" 
         IsAdd="true"
         CancelRequest="Cancel"
         EmulatorList="EmulatorList"
         ValidationResult="@(async (success) => await ValidationResultAsync(success))" />
}

@if (Success)
{
  <br />
  <div class="alert alert-success">The Emulator Core was successfully added.</div>
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to add the Emulator Core (@ErrorMessage).</div>
}

@code {
  private EmulatorCore? EmulatorCore { get; set; }
  
  // Add a list to store the emulators for the dropdown
  private List<Emulator>? EmulatorList { get; set; }

  private bool Busy;

  private bool Success;

  private bool Error;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    // Create new context to load emulators
    using var context = DbFactory.CreateDbContext();
    
    // Load emulators for the dropdown
    if (context.Emulators != null)
    {
      EmulatorList = await context.Emulators.OrderBy(e => e.Name).ToListAsync();
    }
    else
    {
      EmulatorList = new List<Emulator>();
    }
    
    EmulatorCore = new();
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Success = false;
      Error = false;
      return;
    }

    Busy = true;

    using var context = DbFactory.CreateDbContext();

    if (EmulatorCore is not null)
    {
      // If EmulatorCore has a selected Emulator reference, we need to attach it properly
      if (EmulatorCore.Emulator != null && EmulatorCore.Emulator.Id != Guid.Empty)
      {
        // Avoid duplicate entity tracking by getting a reference to the existing emulator
        var existingEmulator = await context.Emulators.FindAsync(EmulatorCore.Emulator.Id);
        if (existingEmulator != null)
        {
          EmulatorCore.Emulator = existingEmulator;
        }
      }
      
      context.EmulatorCores?.Add(EmulatorCore);
    }

    try
    {
      await context.SaveChangesAsync();
      Success = true;
      Error = false;

      Navigation.NavigateTo($"/admin/emulator-core/view/{EmulatorCore?.Id}");
    }
    catch (Exception ex)
    {
      Success = false;
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel() => Navigation.NavigateTo($"/admin/emulator-core");
}
