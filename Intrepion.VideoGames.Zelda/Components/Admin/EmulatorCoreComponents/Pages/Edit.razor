@page "/admin/emulator-core/add"
@page "/admin/emulator-core/edit/{EmulatorCoreId:guid?}"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Emulator Core @(IsAdd ? "Add" : "Edit")</PageTitle>

@if (EmulatorCore is null && !Busy && !IsAdd)
{
  <p>Could not find Emulator Core with id @EmulatorCoreId.</p>
}
else
{
  <EmulatorCoreForm Busy="Busy" 
         CancelRequest="Cancel"
         DbEmulatorCore="DbEmulatorCore" 
         EmulatorCore="EmulatorCore" 
         EmulatorList="EmulatorList"
         IsAdd="IsAdd"
         ValidationResult="@(async (success) => await ValidationResultAsync(success))" />
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to @(IsAdd ? "add" : "update") the Emulator Core (@ErrorMessage).</div>
}

@code {
  [Parameter]
  public Guid? EmulatorCoreId { get; set; }

  // Determine if we're in Add mode based on the route
  private bool IsAdd => EmulatorCoreId == null;

  private ApplicationDbContext? Context { get; set; }

  private EmulatorCore? EmulatorCore { get; set; }

  private EmulatorCore DbEmulatorCore { get; set; } = new EmulatorCore();
  
  // List to store the emulators for the dropdown
  private List<Emulator>? EmulatorList { get; set; }

  private bool Busy;

  private bool Error;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    Busy = true;

    try
    {
      Context = DbFactory.CreateDbContext();

      // Load emulators for the dropdown in both cases
      if (Context.Emulators != null)
      {
        EmulatorList = await Context.Emulators.OrderBy(e => e.Name).ToListAsync();
      }
      else
      {
        EmulatorList = new List<Emulator>();
      }

      if (IsAdd)
      {
        // In Add mode, just create a new EmulatorCore
        EmulatorCore = new();
      }
      else if (Context is not null && Context.EmulatorCores is not null)
      {
        // In Edit mode, load the existing EmulatorCore with its Emulator
        var emulatorCore = await Context.EmulatorCores
            .Include(e => e.Emulator)
            .SingleOrDefaultAsync(x => x.Id == EmulatorCoreId);

        if (emulatorCore is not null)
        {
          EmulatorCore = emulatorCore;
        }
      }
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Error = false;
      return;
    }

    Busy = true;

    try
    {
      if (Context is not null && EmulatorCore is not null)
      {
        // Handle the Emulator reference for both Add and Edit
        if (EmulatorCore.Emulator != null && EmulatorCore.Emulator.Id != Guid.Empty)
        {
          // Avoid duplicate entity tracking by getting a reference to the existing emulator
          var existingEmulator = await Context.Emulators.FindAsync(EmulatorCore.Emulator.Id);
          if (existingEmulator != null)
          {
            EmulatorCore.Emulator = existingEmulator;
          }
        }
        
        // Add the entity if we're in Add mode
        if (IsAdd && Context.EmulatorCores != null)
        {
          Context.EmulatorCores.Add(EmulatorCore);
        }
        
        await Context.SaveChangesAsync();
      }

      Navigation.NavigateTo($"/admin/emulator-core/view/{EmulatorCore?.Id}");
    }
    catch (DbUpdateConcurrencyException dbex)
    {
      // This only happens in Edit mode
      var dbValues = dbex.Entries[0].GetDatabaseValues();

      if (dbValues is null)
      {
        Navigation.NavigateTo($"/admin/emulator-core/view/{EmulatorCore?.Id}");
        return;
      }

      DbEmulatorCore = (EmulatorCore)dbValues.ToObject();

      dbex.Entries[0].OriginalValues.SetValues(dbValues);
      Error = false;
      Busy = false;
    }
    catch (Exception ex)
    {
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel()
  {
    Busy = true;
    Navigation.NavigateTo($"/admin/emulator-core");
  }

  public void Dispose() => Context?.Dispose();
}
