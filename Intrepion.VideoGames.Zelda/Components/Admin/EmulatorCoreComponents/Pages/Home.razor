@page "/admin/emulator-core"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Emulator Core Home</PageTitle>

<h1>Emulator Core Home</h1>
<h6><a href="/admin/emulator-core/add">Create New</a></h6>

<div class="container-fluid">
  <table class="table table-hover table-primary table-striped">
    <thead>
      <tr>
        <th>Actions</th>
        <th>Emulator</th>
        <th>Is Test?</th>
        <th>Name</th>
        @* TableHeaderCodePlaceholder *@
      </tr>
    </thead>
    <tbody>
      @if (emulatorCores is not null)
      {
        @foreach (var emulatorCore in emulatorCores)
        {
          <tr>
            <td>
              <div class="btn-group">
                <a class="btn btn-primary btn-sm btn-info" href="/admin/emulator-core/view/@emulatorCore.Id" title="View">
                  <i class="bi bi-eye"></i>
                </a>
                <a class="btn btn-primary btn-sm" href="/admin/emulator-core/edit/@emulatorCore.Id" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
              </div>
            </td>
            <td>@emulatorCore?.Emulator?.Name</td>
            <td>
              @if (emulatorCore != null && emulatorCore.IsTest)
              {
                <span class="badge bg-success">Yes</span>
              }
              else
              {
                <span class="badge bg-warning text-dark">No</span>
              }
            </td>
            <td>@emulatorCore?.Name</td>
            @* TableRowCodePlaceholder *@
          </tr>
        }
      }
    </tbody>
  </table>
</div>

@code {
  private ICollection<EmulatorCore>? emulatorCores { get; set; }

  protected override async Task OnParametersSetAsync()
  {
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    emulatorCores = new List<EmulatorCore>();

    using var context = DbFactory.CreateDbContext();
    var query = context.EmulatorCores?.AsQueryable();

    if (query is not null)
    {
      emulatorCores = await query
        .Include(x => x.Emulator)
        @* QueryIncludeCodePlaceholder *@
        .AsNoTracking().ToListAsync();
    }
  }
}

