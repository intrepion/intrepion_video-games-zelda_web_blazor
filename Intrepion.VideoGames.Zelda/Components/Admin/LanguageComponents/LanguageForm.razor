<h1>@Mode Language</h1>

<hr />
@if (Language is not null)
{
    <EditForm Model="Language" OnInvalidSubmit="(async () => await HandleSubmitAsync(false))" OnValidSubmit="(async () => await HandleSubmitAsync(true))">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Is Test?:
                <InputCheckbox @bind-Value="Language.IsTest" @oninput="HandleIsTestChange" class="form-check-input"/>
            </label>
        </div>
        <div class="mb-3">
            <label class="form-label">Name:
                <InputText @bind-Value="Language.Name" @oninput="HandleNameChange" class="form-control"/>
            </label>
        </div>
        <div class="mb-3">
            <label class="form-label">Native:
                <InputText @bind-Value="Language.Native" @oninput="HandleNativeChange" class="form-control"/>
            </label>
        </div>
        @* PropertyFormCodePlaceholder *@

        <button type="button" disabled="@Busy" class="btn btn-warning" @onclick="CancelAsync">
            Cancel
        </button>&nbsp;
        <button disabled="@Busy" type="submit" class="btn btn-primary">
            Submit
        </button>
    </EditForm>
}

@code {
    [Parameter]
    public EventCallback<bool> ValidationResult { get; set; }

    [Parameter]
    public EventCallback CancelRequest { get; set; }

    [Parameter]
    public bool IsAdd { get; set; }

    [Parameter]
    public Language? Language { get; set; }

    [Parameter]
    public Language? DbLanguage { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    private string Mode => IsAdd ? "Add" : "Edit";

    @* DeclareListCodePlaceholder *@

    protected override void OnInitialized()
    {
        @* OnInitialCodePlaceholder *@
        @* if (EmulatorCore?.Emulator != null && !IsAdd)
        {
            SelectedEmulatorId = EmulatorCore.Emulator.Id;
        } *@
    }

    private async Task CancelAsync() => await CancelRequest.InvokeAsync(null);

    private async Task HandleSubmitAsync(bool isValid) => await ValidationResult.InvokeAsync(isValid);

    private void HandleIsTestChange(ChangeEventArgs changeEventArgs)
    {
        // SpecializedCodeIsTestPlaceholder
    }

    private void HandleNameChange(ChangeEventArgs changeEventArgs)
    {
        if (Language == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        Language.NormalizedName = ((string)changeEventArgs.Value).ToUpperInvariant();

        // SpecializedCodeNamePlaceholder
    }

    private void HandleNativeChange(ChangeEventArgs changeEventArgs)
    {
        // SpecializedCodeNativePlaceholder
    }

    // HandleChangeCodePlaceholder
}
