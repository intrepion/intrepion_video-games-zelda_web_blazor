@page "/admin/language/add"
@page "/admin/language/edit/{LanguageId:guid?}"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Language @(IsAdd ? "Add" : "Edit")</PageTitle>

@if (Language is null && !Busy && !IsAdd)
{
  <p>Could not find Language with id @LanguageId.</p>
}
else
{
    @* EmulatorList="EmulatorList" *@
  <LanguageForm
    Busy="Busy" 
    CancelRequest="Cancel"
    DbLanguage="DbLanguage" 
    Language="Language" 
    IsAdd="IsAdd"
    ValidationResult="@(async (success) => await ValidationResultAsync(success))"
  />
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to @(IsAdd ? "add" : "update") the Language (@ErrorMessage).</div>
}

@code {
  [Parameter]
  public Guid? LanguageId { get; set; }

  private bool IsAdd => LanguageId == null;

  private ApplicationDbContext? Context { get; set; }

  private Language? Language { get; set; }

  private Language DbLanguage { get; set; } = new Language();

  @* ListDeclarationCodePlaceholder *@
  @* private List<Emulator> EmulatorList { get; set; } = new List<Emulator>();*@

  private bool Busy;

  private bool Error;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    Busy = true;

    try
    {
      Context = DbFactory.CreateDbContext();

      @* LoadListCodePlaceholder *@
      @* if (Context.Emulators != null)
      {
        EmulatorList = await Context.Emulators.OrderBy(e => e.Name).ToListAsync();
      } *@

      if (IsAdd)
      {
        Language = new();
      }
      else if (Context is not null && Context.Languages is not null)
      {
        var language = await Context.Languages
            @* IncludeListCodePlaceholder *@
            @* .Include(e => e.Emulator) *@
            .SingleOrDefaultAsync(x => x.Id == LanguageId);

        if (language is not null)
        {
          Language = language;
        }
      }
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Error = false;
      return;
    }

    Busy = true;

    try
    {
      if (Context is not null && Language is not null)
      {
        @* SetExistingCodePlaceholder *@
        @* if (Language.Emulator != null && Language.Emulator.Id != Guid.Empty)
        {
          var existingEmulator = await Context.Emulators.FindAsync(Language.Emulator.Id);
          if (existingEmulator != null)
          {
            Language.Emulator = existingEmulator;
          }
        } *@
        
        if (IsAdd && Context.Languages != null)
        {
          Context.Languages.Add(Language);
        }
        
        await Context.SaveChangesAsync();
      }

      Navigation.NavigateTo($"/admin/language/view/{Language?.Id}");
    }
    catch (DbUpdateConcurrencyException dbex)
    {
      var dbValues = dbex.Entries[0].GetDatabaseValues();

      if (dbValues is null)
      {
        Navigation.NavigateTo($"/admin/language/view/{Language?.Id}");
        return;
      }

      DbLanguage = (Language)dbValues.ToObject();

      dbex.Entries[0].OriginalValues.SetValues(dbValues);
      Error = false;
      Busy = false;
    }
    catch (Exception ex)
    {
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel()
  {
    Busy = true;
    Navigation.NavigateTo($"/admin/language");
  }

  public void Dispose() => Context?.Dispose();
}
