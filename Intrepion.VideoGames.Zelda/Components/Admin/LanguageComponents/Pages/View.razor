@page "/admin/language/view/{LanguageId:guid}"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject EditSuccess EditSuccessState

<PageTitle>Language View</PageTitle>

@if (NotFound && !Loading)
{
  <div class="alert alert-warning">Language with that id doesn't exist.</div>
}
else
{
  @if (Language is null || Loading)
  {
    <div class="alert alert-info">Loading...</div>
  }
  else
  {
    <h1>Language Details</h1>
    <h6>ID: @Language.Id</h6>
    @* PageHeaderCodePlaceholder *@

    <br />
    @if (EditSuccess)
    {
      <div class="alert alert-success">Successfully updated the Language.</div>
    }
    <hr />

    <div class="container-fluid">
      <table class="table table-hover table-primary table-striped">
        <thead>
          <tr>
            <th>Property</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>ID</td>
            <td>@Language.Id</td>
          </tr>
          <tr>
            <td>IsTest</td>
            <td>@Language?.IsTest</td>
          </tr>
          <tr>
            <td>Name</td>
            <td>@Language?.Name</td>
          </tr>
          <tr>
            <td>Native</td>
            <td>@Language?.Native</td>
          </tr>
          @* ViewPropertyCodePlaceholder *@
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <a class="btn btn-primary" title="Go Back" href="admin/language">
        Back to Grid
      </a>
      <span>&nbsp;</span>
      @if (!Deleted)
      {
        <a class="btn btn-primary" href="admin/language/edit/@Language.Id" title="Edit">Edit</a>

        <span>&nbsp;</span>
        @if (!ShowConfirmation)
        {
          <button class="btn btn-danger" @onclick="@(() => { ShowConfirmation = true; EditSuccess = false; })">Delete</button>
        }
        else
        {
          <br />
          <br />
          <DeletePrompt Confirmation="@(async result => await ConfirmAsync(result))" />
        }
      }
      else
      {
        <div class="btn btn-danger">🚫 This Language has been deleted.</div>
      }
    </div>
  }
}

@code {
  private bool Loading;

  [Parameter]
  public Guid LanguageId { get; set; }

  private Guid _lastLanguageId;

  [Parameter]
  public bool EditSuccess { get; set; }

  private Language? Language { get; set; }

  private bool NotFound = false;

  private bool ShowConfirmation = false;

  private bool Deleted = false;

  protected override async Task OnParametersSetAsync()
  {
    if (_lastLanguageId != LanguageId)
    {
      EditSuccess = EditSuccessState.Success;
      EditSuccessState.Success = false;
      _lastLanguageId = LanguageId;
      await LoadLanguageAsync();
    }
  }

  private async Task ConfirmAsync(bool result)
  {
    if (result)
    {
      await DeleteAsync();
    }
    else
    {
      ShowConfirmation = false;
      EditSuccess = false;
    }
  }

  private async Task LoadLanguageAsync()
  {
    if (Loading)
    {
      return;
    }

    NotFound = false;
    Language = null;

    Loading = true;

    using var context = DbFactory.CreateDbContext();

    if (context.Languages is not null)
    {
      Language = await context.Languages
        @* TableIncludeCodePlaceholder *@
        @* .Include(x => x.Employee)
        .Include(x => x.Manager) *@
        .AsNoTracking()
        .SingleOrDefaultAsync(
          x => x.Id == LanguageId);

      if (Language is null)
      {
        NotFound = true;
      }
    }

    Loading = false;
  }

  private async Task DeleteAsync()
  {
    if (Loading)
    {
      return;
    }

    Loading = true;
    using var context = DbFactory?.CreateDbContext();

    if (context?.Languages is not null)
    {
      var language = await context.Languages
        .SingleOrDefaultAsync(x => x.Id == LanguageId);

      if (language is not null)
      {
        context.Languages?.Remove(language);
        await context.SaveChangesAsync();
        Loading = false;
        Deleted = true;
      }
      else
      {
        Loading = false;
        await LoadLanguageAsync();
      }
    }
    else
    {
      Loading = false;
      await LoadLanguageAsync();
    }
  }
}
