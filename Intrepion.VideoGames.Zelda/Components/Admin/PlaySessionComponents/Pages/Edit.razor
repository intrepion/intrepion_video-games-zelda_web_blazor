@page "/admin/play-session/add"
@page "/admin/play-session/edit/{PlaySessionId:guid?}"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Play Session @(IsAdd ? "Add" : "Edit")</PageTitle>

@if (PlaySession is null && !Busy && !IsAdd)
{
  <p>Could not find Play Session with id @PlaySessionId.</p>
}
else
{
    @* EmulatorList="EmulatorList" *@
  <PlaySessionForm
    EmulatorCoreList="EmulatorCoreList"
    RomList="RomList"
    Busy="Busy" 
    CancelRequest="Cancel"
    DbPlaySession="DbPlaySession" 
    PlaySession="PlaySession" 
    IsAdd="IsAdd"
    ValidationResult="@(async (success) => await ValidationResultAsync(success))"
  />
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to @(IsAdd ? "add" : "update") the Play Session (@ErrorMessage).</div>
}

@code {
  [Parameter]
  public Guid? PlaySessionId { get; set; }

  private bool IsAdd => PlaySessionId == null;

  private ApplicationDbContext? Context { get; set; }

  private PlaySession? PlaySession { get; set; }

  private PlaySession DbPlaySession { get; set; } = new PlaySession();

  private List<EmulatorCore> EmulatorCoreList { get; set; } = new List<EmulatorCore>();
  private List<Rom> RomList { get; set; } = new List<Rom>();
  @* ListDeclarationCodePlaceholder *@
  @* private List<Emulator> EmulatorList { get; set; } = new List<Emulator>();*@

  private bool Busy;

  private bool Error;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    Busy = true;

    try
    {
      Context = DbFactory.CreateDbContext();

      if (Context.EmulatorCores != null)
      {
        EmulatorCoreList = await Context.EmulatorCores.ToListAsync();
      }
      if (Context.Roms != null)
      {
        RomList = await Context.Roms.ToListAsync();
      }
      @* LoadListCodePlaceholder *@
      @* if (Context.Emulators != null)
      {
        EmulatorList = await Context.Emulators.OrderBy(e => e.Name).ToListAsync();
      } *@

      if (IsAdd)
      {
        PlaySession = new();
      }
      else if (Context is not null && Context.PlaySessions is not null)
      {
        var playSession = await Context.PlaySessions
            .Include(x => x.EmulatorCore)
            .Include(x => x.Rom)
            @* IncludeListCodePlaceholder *@
            @* .Include(e => e.Emulator) *@
            .SingleOrDefaultAsync(x => x.Id == PlaySessionId);

        if (playSession is not null)
        {
          PlaySession = playSession;
        }
      }
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Error = false;
      return;
    }

    Busy = true;

    try
    {
      if (Context is not null && PlaySession is not null)
      {
        @* SetExistingCodePlaceholder *@
        @* if (PlaySession.Emulator != null && PlaySession.Emulator.Id != Guid.Empty)
        {
          var existingEmulator = await Context.Emulators.FindAsync(PlaySession.Emulator.Id);
          if (existingEmulator != null)
          {
            PlaySession.Emulator = existingEmulator;
          }
        } *@
        
        if (IsAdd && Context.PlaySessions != null)
        {
          Context.PlaySessions.Add(PlaySession);
        }
        
        await Context.SaveChangesAsync();
      }

      Navigation.NavigateTo($"/admin/play-session/view/{PlaySession?.Id}");
    }
    catch (DbUpdateConcurrencyException dbex)
    {
      var dbValues = dbex.Entries[0].GetDatabaseValues();

      if (dbValues is null)
      {
        Navigation.NavigateTo($"/admin/play-session/view/{PlaySession?.Id}");
        return;
      }

      DbPlaySession = (PlaySession)dbValues.ToObject();

      dbex.Entries[0].OriginalValues.SetValues(dbValues);
      Error = false;
      Busy = false;
    }
    catch (Exception ex)
    {
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel()
  {
    Busy = true;
    Navigation.NavigateTo($"/admin/play-session");
  }

  public void Dispose() => Context?.Dispose();
}
