@page "/admin/play-session/edit/{PlaySessionId:guid}"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject EditSuccess EditSuccessState

<PageTitle>Play Session Edit</PageTitle>

@if (PlaySession is null && !Busy)
{
  <p>Could not find Play Session with id @PlaySessionId.</p>
}
else
{
  <PlaySessionForm Busy="Busy" 
         PlaySession="PlaySession" 
         DbPlaySession="DbPlaySession" 
         IsAdd="false" 
         CancelRequest="Cancel" 
         ValidationResult="@(async (success) => await ValidationResultAsync(success))" />
}

@if (ConcurrencyError)
{
  <br />
  <div class="alert alert-danger">
    <p>
      The Play Session details have changed since it was last loaded. The updated fields are highlighted in the form.
      Please choose an option:
    </p>
    <p><b>Cancel</b> to lose your changes and keep the database version.</p>
    <p><b>Submit</b> to force an update with your version.</p>
  </div>
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to update the Play Session (@ErrorMessage).</div>
}

@code {
  [Parameter]
  public Guid PlaySessionId { get; set; }

  private ApplicationDbContext? Context { get; set; }

  private PlaySession PlaySession { get; set; } = new PlaySession();

  private PlaySession DbPlaySession { get; set; } = new PlaySession();

  private bool Busy;

  private bool Error;

  private bool ConcurrencyError;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    Busy = true;

    try
    {
      Context = DbFactory.CreateDbContext();

      if (Context is not null && Context.PlaySessions is not null)
      {
        var playSession = await Context.PlaySessions.SingleOrDefaultAsync(x => x.Id == PlaySessionId);

        if (playSession is not null)
        {
          PlaySession = playSession;
        }
      }
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Error = false;
      ConcurrencyError = false;
      return;
    }

    Busy = true;
    try
    {
      if (Context is not null)
      {
        await Context.SaveChangesAsync();
      }

      EditSuccessState.Success = true;
      Navigation.NavigateTo($"/admin/play-session/view/{PlaySession.Id}");
    }
    catch (DbUpdateConcurrencyException dbex)
    {
      EditSuccessState.Success = false;

      ConcurrencyError = true;

      var dbValues = dbex.Entries[0].GetDatabaseValues();

      if (dbValues is null)
      {
        Navigation.NavigateTo($"/admin/play-session/view/{PlaySession.Id}");
        return;
      }

      DbPlaySession = (PlaySession)dbValues.ToObject();

      dbex.Entries[0].OriginalValues.SetValues(dbValues);
      Error = false;
      Busy = false;
    }
    catch (Exception ex)
    {
      EditSuccessState.Success = false;
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel()
  {
    Busy = true;
    Navigation.NavigateTo($"/admin/play-session");
  }

  public void Dispose() => Context?.Dispose();
}
