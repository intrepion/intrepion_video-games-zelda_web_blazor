@page "/admin/play-session"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Play Session Home</PageTitle>

<h1>Play Session Home</h1>
<h6><a href="/admin/play-session/add">Create New</a></h6>

<div class="container-fluid">
  <table class="table table-hover table-primary table-striped">
    <thead>
      <tr>
        <th>Actions</th>
        <th>Emulator Core</th>
        <th>End Date Time</th>
        <th>Is Test?</th>
        <th>Rom</th>
        <th>Start Date Time</th>
        @* TableHeaderCodePlaceholder *@
      </tr>
    </thead>
    <tbody>
      @if (playSessions is not null)
      {
        @foreach (var playSession in playSessions)
        {
          <tr>
            <td>
              <div class="btn-group">
                <a class="btn btn-primary btn-sm btn-info" href="/admin/play-session/view/@playSession.Id" title="View">
                  <i class="bi bi-eye"></i>
                </a>
                <a class="btn btn-primary btn-sm" href="/admin/play-session/edit/@playSession.Id" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
              </div>
            </td>
            <td>@playSession?.EmulatorCore?.NormalizedName</td>
            <td>@playSession?.EndDateTime</td>
            <td>
              @if (playSession is not null && playSession.IsTest)
              {
                <span class="badge bg-success">Yes</span>
              }
              else
              {
                <span class="badge bg-warning text-dark">No</span>
              }
            </td>
            <td>@playSession?.Rom?.FileName</td>
            <td>@playSession?.StartDateTime</td>
            @* TableRowCodePlaceholder *@
          </tr>
        }
      }
    </tbody>
  </table>
</div>

@code {
  private ICollection<PlaySession>? playSessions { get; set; }

  protected override async Task OnParametersSetAsync()
  {
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    playSessions = new List<PlaySession>();

    using var context = DbFactory.CreateDbContext();
    var query = context.PlaySessions?.AsQueryable();

    if (query is not null)
    {
      playSessions = await query
        .Include(x => x.EmulatorCore)
        .Include(x => x.Rom)
        @* QueryIncludeCodePlaceholder *@
        .AsNoTracking().ToListAsync();
    }
  }
}

