@page "/admin/play-session/view/{PlaySessionId:guid}"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject EditSuccess EditSuccessState

<PageTitle>Play Session View</PageTitle>

@if (NotFound && !Loading)
{
  <div class="alert alert-warning">Play Session with that id doesn't exist.</div>
}
else
{
  @if (PlaySession is null || Loading)
  {
    <div class="alert alert-info">Loading...</div>
  }
  else
  {
    <h1>@PlaySession.Id</h1>
        @* PageHeaderCodePlaceholder *@

    <br />
    @if (EditSuccess)
    {
      <div class="alert alert-success">Successfully updated the Play Session.</div>
    }
    <hr />
    <h2>Id</h2>
    <br />
    <h3>@PlaySession.Id</h3>
    <br />

    <h2>EndDateTime</h2>
        <br />
        <h3>@PlaySession.EndDateTime</h3>
        <br />
        <h2>IsTest</h2>
        <br />
        <h3>@PlaySession.IsTest</h3>
        <br />
        <h2>StartDateTime</h2>
        <br />
        <h3>@PlaySession.StartDateTime</h3>
        <br />
        @* PropertyCodePlaceholder *@

    <a class="btn btn-primary" title="Go Back" href="admin/play-session   ">
      Back to Grid
    </a>
    <span>&nbsp;</span>
    @if (!Deleted)
    {
      <a class="btn btn-primary" href="admin/play-session/edit/@PlaySession.Id" title="Edit">Edit</a>

      <span>&nbsp;</span>
      @if (!ShowConfirmation)
      {
        <button class="btn btn-danger" @onclick="@(() => { ShowConfirmation = true; EditSuccess = false; })">Delete</button>
      }
      else
      {
        <br />
        <br />
        <DeletePrompt Confirmation="@(async result => await ConfirmAsync(result))" />
      }
    }
    else
    {
      <div class="btn btn-danger">🚫 This Play Session has been deleted.</div>
    }
  }
}

@code {
  private bool Loading;

  [Parameter]
  public Guid PlaySessionId { get; set; }

  private Guid _lastPlaySessionId;

  [Parameter]
  public bool EditSuccess { get; set; }

  private PlaySession? PlaySession { get; set; }

  private bool NotFound = false;

  private bool ShowConfirmation = false;

  private bool Deleted = false;

  protected override async Task OnParametersSetAsync()
  {
    if (_lastPlaySessionId != PlaySessionId)
    {
      EditSuccess = EditSuccessState.Success;
      EditSuccessState.Success = false;
      _lastPlaySessionId = PlaySessionId;
      await LoadPlaySessionAsync();
    }
  }

  private async Task ConfirmAsync(bool result)
  {
    if (result)
    {
      await DeleteAsync();
    }
    else
    {
      ShowConfirmation = false;
      EditSuccess = false;
    }
  }

  private async Task LoadPlaySessionAsync()
  {
    if (Loading)
    {
      return;
    }

    NotFound = false;
    PlaySession = null;

    Loading = true;

    using var context = DbFactory.CreateDbContext();

    if (context.PlaySessions is not null)
    {
      PlaySession = await context.PlaySessions
        .AsNoTracking()
        .SingleOrDefaultAsync(
          x => x.Id == PlaySessionId);

      if (PlaySession is null)
      {
        NotFound = true;
      }
    }

    Loading = false;
  }

  private async Task DeleteAsync()
  {
    if (Loading)
    {
      return;
    }

    Loading = true;
    using var context = DbFactory?.CreateDbContext();

    if (context?.PlaySessions is not null)
    {
      var playSession = await context.PlaySessions
        .SingleOrDefaultAsync(x => x.Id == PlaySessionId);

      if (playSession is not null)
      {
        context.PlaySessions?.Remove(playSession);
        await context.SaveChangesAsync();
        Loading = false;
        Deleted = true;
      }
      else
      {
        Loading = false;
        await LoadPlaySessionAsync();
      }
    }
    else
    {
      Loading = false;
      await LoadPlaySessionAsync();
    }
  }
}
