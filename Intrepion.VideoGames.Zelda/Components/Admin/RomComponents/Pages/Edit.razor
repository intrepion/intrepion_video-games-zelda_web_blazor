@page "/admin/rom/add"
@page "/admin/rom/edit/{RomId:guid?}"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Rom @(IsAdd ? "Add" : "Edit")</PageTitle>

@if (Rom is null && !Busy && !IsAdd)
{
  <p>Could not find Rom with id @RomId.</p>
}
else
{
    @* EmulatorList="EmulatorList" *@
  <RomForm
    GameConsoleList="GameConsoleList"
    WebSiteList="WebSiteList"
    WebSiteSubcategoryList="WebSiteSubcategoryList"
    Busy="Busy" 
    CancelRequest="Cancel"
    DbRom="DbRom" 
    Rom="Rom" 
    IsAdd="IsAdd"
    ValidationResult="@(async (success) => await ValidationResultAsync(success))"
  />
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to @(IsAdd ? "add" : "update") the Rom (@ErrorMessage).</div>
}

@code {
  [Parameter]
  public Guid? RomId { get; set; }

  private bool IsAdd => RomId == null;

  private ApplicationDbContext? Context { get; set; }

  private Rom? Rom { get; set; }

  private Rom DbRom { get; set; } = new Rom();

  private List<GameConsole> GameConsoleList { get; set; } = new List<GameConsole>();
  private List<WebSite> WebSiteList { get; set; } = new List<WebSite>();
  private List<WebSiteSubcategory> WebSiteSubcategoryList { get; set; } = new List<WebSiteSubcategory>();
  @* ListDeclarationCodePlaceholder *@
  @* private List<Emulator> EmulatorList { get; set; } = new List<Emulator>();*@

  private bool Busy;

  private bool Error;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    Busy = true;

    try
    {
      Context = DbFactory.CreateDbContext();

      if (Context.GameConsoles != null)
      {
        GameConsoleList = await Context.GameConsoles.ToListAsync();
      }
      if (Context.WebSites != null)
      {
        WebSiteList = await Context.WebSites.ToListAsync();
      }
      if (Context.WebSiteSubcategories != null)
      {
        WebSiteSubcategoryList = await Context.WebSiteSubcategories.ToListAsync();
      }
      @* LoadListCodePlaceholder *@
      @* if (Context.Emulators != null)
      {
        EmulatorList = await Context.Emulators.OrderBy(e => e.Name).ToListAsync();
      } *@

      if (IsAdd)
      {
        Rom = new();
      }
      else if (Context is not null && Context.Roms is not null)
      {
        var rom = await Context.Roms
            .Include(x => x.GameConsole)
            .Include(x => x.WebSite)
            .Include(x => x.WebSiteSubcategory)
            @* IncludeListCodePlaceholder *@
            @* .Include(e => e.Emulator) *@
            .SingleOrDefaultAsync(x => x.Id == RomId);

        if (rom is not null)
        {
          Rom = rom;
        }
      }
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Error = false;
      return;
    }

    Busy = true;

    try
    {
      if (Context is not null && Rom is not null)
      {
        @* SetExistingCodePlaceholder *@
        @* if (Rom.Emulator != null && Rom.Emulator.Id != Guid.Empty)
        {
          var existingEmulator = await Context.Emulators.FindAsync(Rom.Emulator.Id);
          if (existingEmulator != null)
          {
            Rom.Emulator = existingEmulator;
          }
        } *@
        
        if (IsAdd && Context.Roms != null)
        {
          Context.Roms.Add(Rom);
        }
        
        await Context.SaveChangesAsync();
      }

      Navigation.NavigateTo($"/admin/rom/view/{Rom?.Id}");
    }
    catch (DbUpdateConcurrencyException dbex)
    {
      var dbValues = dbex.Entries[0].GetDatabaseValues();

      if (dbValues is null)
      {
        Navigation.NavigateTo($"/admin/rom/view/{Rom?.Id}");
        return;
      }

      DbRom = (Rom)dbValues.ToObject();

      dbex.Entries[0].OriginalValues.SetValues(dbValues);
      Error = false;
      Busy = false;
    }
    catch (Exception ex)
    {
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel()
  {
    Busy = true;
    Navigation.NavigateTo($"/admin/rom");
  }

  public void Dispose() => Context?.Dispose();
}
