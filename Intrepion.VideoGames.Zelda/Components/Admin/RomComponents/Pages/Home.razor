@page "/admin/rom"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Rom Home</PageTitle>

<h1>Rom Home</h1>
<h6><a href="/admin/rom/add">Create New</a></h6>

<div class="container-fluid">
  <table class="table table-hover table-primary table-striped">
    <thead>
      <tr>
        <th>Actions</th>
        <th>File Name</th>
        <th>Game Console</th>
        <th>Is Test?</th>
        <th>SHA256 Sum</th>
        <th>Web Site Subcategory</th>
        @* TableHeaderCodePlaceholder *@
      </tr>
    </thead>
    <tbody>
      @if (roms is not null)
      {
        @foreach (var rom in roms)
        {
          <tr>
            <td>
              <div class="btn-group">
                <a class="btn btn-primary btn-sm btn-info" href="/admin/rom/view/@rom.Id" title="View">
                  <i class="bi bi-eye"></i>
                </a>
                <a class="btn btn-primary btn-sm" href="/admin/rom/edit/@rom.Id" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
              </div>
            </td>
            <td>@rom?.FileName</td>
            <td>@rom?.GameConsole?.NormalizedName</td>
            <td>
              @if (rom is not null && rom.IsTest)
              {
                <span class="badge bg-success">Yes</span>
              }
              else
              {
                <span class="badge bg-warning text-dark">No</span>
              }
            </td>
            <td>@rom?.Sha256Sum</td>
            <td>@rom?.WebSiteSubcategory?.NormalizedName</td>
            @* TableRowCodePlaceholder *@
          </tr>
        }
      }
    </tbody>
  </table>
</div>

@code {
  private ICollection<Rom>? roms { get; set; }

  protected override async Task OnParametersSetAsync()
  {
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    roms = new List<Rom>();

    using var context = DbFactory.CreateDbContext();
    var query = context.Roms?.AsQueryable();

    if (query is not null)
    {
      roms = await query
        .Include(x => x.GameConsole)
        .Include(x => x.WebSiteSubcategory)
        @* QueryIncludeCodePlaceholder *@
        .AsNoTracking().ToListAsync();
    }
  }
}

