@page "/admin/rom/view/{RomId:guid}"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject EditSuccess EditSuccessState

<PageTitle>Rom View</PageTitle>

@if (NotFound && !Loading)
{
  <div class="alert alert-warning">Rom with that id doesn't exist.</div>
}
else
{
  @if (Rom is null || Loading)
  {
    <div class="alert alert-info">Loading...</div>
  }
  else
  {
    @* <h1>Rom Details</h1>
    <h6>ID: @Rom.Id</h6> *@
    <h1>Rom Details</h1>
    <h6>ID: @Rom.Id</h6>
    @* PageHeaderCodePlaceholder *@

    <br />
    @if (EditSuccess)
    {
      <div class="alert alert-success">Successfully updated the Rom.</div>
    }
    <hr />

    <div class="container-fluid">
      <table class="table table-hover table-primary table-striped">
        <thead>
          <tr>
            <th>Property</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>ID</td>
            <td>@Rom.Id</td>
          </tr>
          <tr>
            <td>FileName</td>
            <td>@Rom?.FileName</td>
          </tr>
          <tr>
            <td>IsTest</td>
            <td>@Rom?.IsTest</td>
          </tr>
          <tr>
            <td>Sha256Sum</td>
            <td>@Rom?.Sha256Sum</td>
          </tr>
          @* ViewPropertyCodePlaceholder *@
          @* <tr>
            <td>Employee</td>
            <td>@Rom?.Employee?.FirstName @Rom?.Employee?.LastName</td>
          </tr>
          <tr>
            <td>Manager</td>
            <td>@Rom?.Manager?.FirstName @Rom?.Manager?.LastName</td>
          </tr> *@
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <a class="btn btn-primary" title="Go Back" href="admin/rom">
        Back to Grid
      </a>
      <span>&nbsp;</span>
      @if (!Deleted)
      {
        <a class="btn btn-primary" href="admin/rom/edit/@Rom.Id" title="Edit">Edit</a>

        <span>&nbsp;</span>
        @if (!ShowConfirmation)
        {
          <button class="btn btn-danger" @onclick="@(() => { ShowConfirmation = true; EditSuccess = false; })">Delete</button>
        }
        else
        {
          <br />
          <br />
          <DeletePrompt Confirmation="@(async result => await ConfirmAsync(result))" />
        }
      }
      else
      {
        <div class="btn btn-danger">🚫 This Rom has been deleted.</div>
      }
    </div>
  }
}

@code {
  private bool Loading;

  [Parameter]
  public Guid RomId { get; set; }

  private Guid _lastRomId;

  [Parameter]
  public bool EditSuccess { get; set; }

  private Rom? Rom { get; set; }

  private bool NotFound = false;

  private bool ShowConfirmation = false;

  private bool Deleted = false;

  protected override async Task OnParametersSetAsync()
  {
    if (_lastRomId != RomId)
    {
      EditSuccess = EditSuccessState.Success;
      EditSuccessState.Success = false;
      _lastRomId = RomId;
      await LoadRomAsync();
    }
  }

  private async Task ConfirmAsync(bool result)
  {
    if (result)
    {
      await DeleteAsync();
    }
    else
    {
      ShowConfirmation = false;
      EditSuccess = false;
    }
  }

  private async Task LoadRomAsync()
  {
    if (Loading)
    {
      return;
    }

    NotFound = false;
    Rom = null;

    Loading = true;

    using var context = DbFactory.CreateDbContext();

    if (context.Roms is not null)
    {
      Rom = await context.Roms
        @* IncludeCodePlaceholder *@
        @* .Include(x => x.Employee)
        .Include(x => x.Manager) *@
        .AsNoTracking()
        .SingleOrDefaultAsync(
          x => x.Id == RomId);

      if (Rom is null)
      {
        NotFound = true;
      }
    }

    Loading = false;
  }

  private async Task DeleteAsync()
  {
    if (Loading)
    {
      return;
    }

    Loading = true;
    using var context = DbFactory?.CreateDbContext();

    if (context?.Roms is not null)
    {
      var rom = await context.Roms
        .SingleOrDefaultAsync(x => x.Id == RomId);

      if (rom is not null)
      {
        context.Roms?.Remove(rom);
        await context.SaveChangesAsync();
        Loading = false;
        Deleted = true;
      }
      else
      {
        Loading = false;
        await LoadRomAsync();
      }
    }
    else
    {
      Loading = false;
      await LoadRomAsync();
    }
  }
}
