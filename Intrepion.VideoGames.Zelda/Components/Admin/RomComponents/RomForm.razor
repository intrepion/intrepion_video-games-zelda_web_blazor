<h1>@Mode Rom</h1>

<hr />
@if (Rom is not null)
{
    <EditForm Model="Rom" OnInvalidSubmit="(async () => await HandleSubmitAsync(false))" OnValidSubmit="(async () => await HandleSubmitAsync(true))">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h2>File Name</h2>
        <p>
            <label>
                File Name:
                <InputText @bind-Value="Rom.FileName" @oninput="HandleFileNameChange"/>
            </label>
        </p>
        <h2>Game Console</h2>
        <p>
            <label>
                Game Console:
                <InputSelect @bind-Value="SelectedGameConsoleId" @oninput="HandleGameConsoleChange">
                    <option value="">-- Select Game Console --</option>
                    @foreach (var gameConsole in GameConsoleList)
                    {
                        <option value="@gameConsole.Id">@gameConsole.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        <h2>Is Test?</h2>
        <p>
            <label>
                Is Test?:
                <InputCheckbox @bind-Value="Rom.IsTest" @oninput="HandleIsTestChange"/>
            </label>
        </p>
        <h2>SHA256 Sum</h2>
        <p>
            <label>
                SHA256 Sum:
                <InputText @bind-Value="Rom.Sha256Sum" @oninput="HandleSha256SumChange"/>
            </label>
        </p>
        <h2>Web Site</h2>
        <p>
            <label>
                Web Site:
                <InputSelect @bind-Value="SelectedWebSiteId" @oninput="HandleWebSiteChange">
                    <option value="">-- Select Web Site --</option>
                    @foreach (var webSite in WebSiteList)
                    {
                        <option value="@webSite.Id">@webSite.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        <h2>Web Site Subcategory</h2>
        <p>
            <label>
                Web Site Subcategory:
                <InputSelect @bind-Value="SelectedWebSiteSubcategoryId" @oninput="HandleWebSiteSubcategoryChange">
                    <option value="">-- Select Web Site Subcategory --</option>
                    @foreach (var webSiteSubcategory in WebSiteSubcategoryList)
                    {
                        <option value="@webSiteSubcategory.Id">@webSiteSubcategory.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        @* PropertyFormCodePlaceholder *@

        <br />
        <button type="button" disabled="@Busy" class="btn btn-warning" @onclick="CancelAsync">
            Cancel
        </button>&nbsp;
        <button disabled="@Busy" type="submit" class="btn btn-primary">
            Submit
        </button>
    </EditForm>
}

@code {
    [Parameter]
    public EventCallback<bool> ValidationResult { get; set; }

    [Parameter]
    public EventCallback CancelRequest { get; set; }

    [Parameter]
    public bool IsAdd { get; set; }

    [Parameter]
    public Rom? Rom { get; set; }

    [Parameter]
    public Rom? DbRom { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    private string Mode => IsAdd ? "Add" : "Edit";

    [Parameter]
    public List<GameConsole> GameConsoleList { get; set; } = new List<GameConsole>();
    private Guid SelectedGameConsoleId;
    [Parameter]
    public List<WebSite> WebSiteList { get; set; } = new List<WebSite>();
    private Guid SelectedWebSiteId;
    [Parameter]
    public List<WebSiteSubcategory> WebSiteSubcategoryList { get; set; } = new List<WebSiteSubcategory>();
    private Guid SelectedWebSiteSubcategoryId;
    @* DeclareListCodePlaceholder *@

    protected override void OnInitialized()
    {
        if (Rom?.GameConsole != null && !IsAdd)
        {
            SelectedGameConsoleId = Rom.GameConsole.Id;
        }
        if (Rom?.WebSite != null && !IsAdd)
        {
            SelectedWebSiteId = Rom.WebSite.Id;
        }
        if (Rom?.WebSiteSubcategory != null && !IsAdd)
        {
            SelectedWebSiteSubcategoryId = Rom.WebSiteSubcategory.Id;
        }
        @* OnInitialCodePlaceholder *@
        @* if (EmulatorCore?.Emulator != null && !IsAdd)
        {
            SelectedEmulatorId = EmulatorCore.Emulator.Id;
        } *@
    }

    private async Task CancelAsync() => await CancelRequest.InvokeAsync(null);

    private async Task HandleSubmitAsync(bool isValid) => await ValidationResult.InvokeAsync(isValid);

    private void HandleFileNameChange(ChangeEventArgs changeEventArgs)
    {
        if (Rom == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        Rom.NormalizedFileName = ((string)changeEventArgs.Value).ToUpperInvariant();

        // SpecializedCodeFileNamePlaceholder
    }

    private void HandleGameConsoleChange(ChangeEventArgs changeEventArgs)
    {
        if (Rom == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        if (changeEventArgs.Value is string value && Guid.TryParse(value, out Guid selectedGameConsoleId))
        {
            SelectedGameConsoleId = selectedGameConsoleId;
            var selectedGameConsole = GameConsoleList.FirstOrDefault(x => x.Id == SelectedGameConsoleId);

            if (selectedGameConsole != null)
            {
                Rom.GameConsole = selectedGameConsole;
            }
        }

        // SpecializedCodeGameConsolePlaceholder
    }

    private void HandleIsTestChange(ChangeEventArgs changeEventArgs)
    {
        // SpecializedCodeIsTestPlaceholder
    }

    private void HandleSha256SumChange(ChangeEventArgs changeEventArgs)
    {
        if (Rom == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        Rom.AlphanumericSha256Sum = new string (((string)changeEventArgs.Value).ToLowerInvariant().Where(char.IsLetterOrDigit).ToArray());

        // SpecializedCodeSha256SumPlaceholder
    }

    private void HandleWebSiteChange(ChangeEventArgs changeEventArgs)
    {
        if (Rom == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        if (changeEventArgs.Value is string value && Guid.TryParse(value, out Guid selectedWebSiteId))
        {
            SelectedWebSiteId = selectedWebSiteId;
            var selectedWebSite = WebSiteList.FirstOrDefault(x => x.Id == SelectedWebSiteId);

            if (selectedWebSite != null)
            {
                Rom.WebSite = selectedWebSite;
            }
        }

        // SpecializedCodeWebSitePlaceholder
    }

    private void HandleWebSiteSubcategoryChange(ChangeEventArgs changeEventArgs)
    {
        if (Rom == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        if (changeEventArgs.Value is string value && Guid.TryParse(value, out Guid selectedWebSiteSubcategoryId))
        {
            SelectedWebSiteSubcategoryId = selectedWebSiteSubcategoryId;
            var selectedWebSiteSubcategory = WebSiteSubcategoryList.FirstOrDefault(x => x.Id == SelectedWebSiteSubcategoryId);

            if (selectedWebSiteSubcategory != null)
            {
                Rom.WebSiteSubcategory = selectedWebSiteSubcategory;
            }
        }

        // SpecializedCodeWebSiteSubcategoryPlaceholder
    }

    // HandleChangeCodePlaceholder
}
