@page "/admin/rom-input/edit/{RomInputId:guid}"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject EditSuccess EditSuccessState

<PageTitle>Rom Input Edit</PageTitle>

@if (RomInput is null && !Busy)
{
  <p>Could not find Rom Input with id @RomInputId.</p>
}
else
{
  <RomInputForm Busy="Busy" 
         RomInput="RomInput" 
         DbRomInput="DbRomInput" 
         IsAdd="false" 
         CancelRequest="Cancel" 
         ValidationResult="@(async (success) => await ValidationResultAsync(success))" />
}

@if (ConcurrencyError)
{
  <br />
  <div class="alert alert-danger">
    <p>
      The Rom Input details have changed since it was last loaded. The updated fields are highlighted in the form.
      Please choose an option:
    </p>
    <p><b>Cancel</b> to lose your changes and keep the database version.</p>
    <p><b>Submit</b> to force an update with your version.</p>
  </div>
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to update the Rom Input (@ErrorMessage).</div>
}

@code {
  [Parameter]
  public Guid RomInputId { get; set; }

  private ApplicationDbContext? Context { get; set; }

  private RomInput RomInput { get; set; } = new RomInput();

  private RomInput DbRomInput { get; set; } = new RomInput();

  private bool Busy;

  private bool Error;

  private bool ConcurrencyError;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    Busy = true;

    try
    {
      Context = DbFactory.CreateDbContext();

      if (Context is not null && Context.RomInputs is not null)
      {
        var romInput = await Context.RomInputs.SingleOrDefaultAsync(x => x.Id == RomInputId);

        if (romInput is not null)
        {
          RomInput = romInput;
        }
      }
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Error = false;
      ConcurrencyError = false;
      return;
    }

    Busy = true;
    try
    {
      if (Context is not null)
      {
        await Context.SaveChangesAsync();
      }

      EditSuccessState.Success = true;
      Navigation.NavigateTo($"/admin/rom-input/view/{RomInput.Id}");
    }
    catch (DbUpdateConcurrencyException dbex)
    {
      EditSuccessState.Success = false;

      ConcurrencyError = true;

      var dbValues = dbex.Entries[0].GetDatabaseValues();

      if (dbValues is null)
      {
        Navigation.NavigateTo($"/admin/rom-input/view/{RomInput.Id}");
        return;
      }

      DbRomInput = (RomInput)dbValues.ToObject();

      dbex.Entries[0].OriginalValues.SetValues(dbValues);
      Error = false;
      Busy = false;
    }
    catch (Exception ex)
    {
      EditSuccessState.Success = false;
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel()
  {
    Busy = true;
    Navigation.NavigateTo($"/admin/rom-input");
  }

  public void Dispose() => Context?.Dispose();
}
