@page "/admin/rom-input/view/{RomInputId:guid}"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject EditSuccess EditSuccessState

<PageTitle>Rom Input View</PageTitle>

@if (NotFound && !Loading)
{
  <div class="alert alert-warning">Rom Input with that id doesn't exist.</div>
}
else
{
  @if (RomInput is null || Loading)
  {
    <div class="alert alert-info">Loading...</div>
  }
  else
  {
    <h1>Rom Input Details</h1>
    <h6>ID: @RomInput.Id</h6>
    @* PageHeaderCodePlaceholder *@

    <br />
    @if (EditSuccess)
    {
      <div class="alert alert-success">Successfully updated the Rom Input.</div>
    }
    <hr />

    <div class="container-fluid">
      <table class="table table-hover table-primary table-striped">
        <thead>
          <tr>
            <th>Property</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>ID</td>
            <td>@RomInput.Id</td>
          </tr>
          <tr>
            <td>IsTest</td>
            <td>@RomInput?.IsTest</td>
          </tr>
          <tr>
            <td>Name</td>
            <td>@RomInput?.Name</td>
          </tr>
          @* ViewPropertyCodePlaceholder *@
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <a class="btn btn-primary" title="Go Back" href="admin/rom-input">
        Back to Grid
      </a>
      <span>&nbsp;</span>
      @if (!Deleted)
      {
        <a class="btn btn-primary" href="admin/rom-input/edit/@RomInput.Id" title="Edit">Edit</a>

        <span>&nbsp;</span>
        @if (!ShowConfirmation)
        {
          <button class="btn btn-danger" @onclick="@(() => { ShowConfirmation = true; EditSuccess = false; })">Delete</button>
        }
        else
        {
          <br />
          <br />
          <DeletePrompt Confirmation="@(async result => await ConfirmAsync(result))" />
        }
      }
      else
      {
        <div class="btn btn-danger">🚫 This Rom Input has been deleted.</div>
      }
    </div>
  }
}

@code {
  private bool Loading;

  [Parameter]
  public Guid RomInputId { get; set; }

  private Guid _lastRomInputId;

  [Parameter]
  public bool EditSuccess { get; set; }

  private RomInput? RomInput { get; set; }

  private bool NotFound = false;

  private bool ShowConfirmation = false;

  private bool Deleted = false;

  protected override async Task OnParametersSetAsync()
  {
    if (_lastRomInputId != RomInputId)
    {
      EditSuccess = EditSuccessState.Success;
      EditSuccessState.Success = false;
      _lastRomInputId = RomInputId;
      await LoadRomInputAsync();
    }
  }

  private async Task ConfirmAsync(bool result)
  {
    if (result)
    {
      await DeleteAsync();
    }
    else
    {
      ShowConfirmation = false;
      EditSuccess = false;
    }
  }

  private async Task LoadRomInputAsync()
  {
    if (Loading)
    {
      return;
    }

    NotFound = false;
    RomInput = null;

    Loading = true;

    using var context = DbFactory.CreateDbContext();

    if (context.RomInputs is not null)
    {
      RomInput = await context.RomInputs
        @* TableIncludeCodePlaceholder *@
        @* .Include(x => x.Employee)
        .Include(x => x.Manager) *@
        .AsNoTracking()
        .SingleOrDefaultAsync(
          x => x.Id == RomInputId);

      if (RomInput is null)
      {
        NotFound = true;
      }
    }

    Loading = false;
  }

  private async Task DeleteAsync()
  {
    if (Loading)
    {
      return;
    }

    Loading = true;
    using var context = DbFactory?.CreateDbContext();

    if (context?.RomInputs is not null)
    {
      var romInput = await context.RomInputs
        .SingleOrDefaultAsync(x => x.Id == RomInputId);

      if (romInput is not null)
      {
        context.RomInputs?.Remove(romInput);
        await context.SaveChangesAsync();
        Loading = false;
        Deleted = true;
      }
      else
      {
        Loading = false;
        await LoadRomInputAsync();
      }
    }
    else
    {
      Loading = false;
      await LoadRomInputAsync();
    }
  }
}
