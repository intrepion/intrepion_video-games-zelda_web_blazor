@page "/admin/rom-state"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Rom State Home</PageTitle>

<h1>Rom State Home</h1>
<h6><a href="/admin/rom-state/add">Create New</a></h6>

<div class="container-fluid">
  <table class="table table-hover table-primary table-striped">
    <thead>
      <tr>
        <th>Actions</th>
        <th>Is Test?</th>
        <th>Name</th>
        <th>T</th>
        <th>X</th>
        <th>Y</th>
        <th>Z</th>
        @* TableHeaderCodePlaceholder *@
      </tr>
    </thead>
    <tbody>
      @if (romStates is not null)
      {
        @foreach (var romState in romStates)
        {
          <tr>
            <td>
              <div class="btn-group">
                <a class="btn btn-primary btn-sm btn-info" href="/admin/rom-state/view/@romState.Id" title="View">
                  <i class="bi bi-eye"></i>
                </a>
                <a class="btn btn-primary btn-sm" href="/admin/rom-state/edit/@romState.Id" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
              </div>
            </td>
            <td>
              @if (romState != null && romState.IsTest)
              {
                <span class="badge bg-success">Yes</span>
              }
              else
              {
                <span class="badge bg-warning text-dark">No</span>
              }
            </td>
            <td>@romState?.Name</td>
            <td>@romState?.T</td>
            <td>@romState?.X</td>
            <td>@romState?.Y</td>
            <td>@romState?.Z</td>
            @* TableRowCodePlaceholder *@
          </tr>
        }
      }
    </tbody>
  </table>
</div>

@code {
  private ICollection<RomState>? romStates { get; set; }

  protected override async Task OnParametersSetAsync()
  {
    await ReloadAsync();
  }

  private async Task ReloadAsync()
  {
    romStates = new List<RomState>();

    using var context = DbFactory.CreateDbContext();
    var query = context.RomStates?.AsQueryable();

    if (query is not null)
    {
      romStates = await query
        @* QueryIncludeCodePlaceholder *@
        .AsNoTracking().ToListAsync();
    }
  }
}

