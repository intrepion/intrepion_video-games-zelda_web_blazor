<h1>@Mode RomState</h1>

<hr />
@if (RomState is not null)
{
    <EditForm Model="RomState" OnInvalidSubmit="(async () => await HandleSubmitAsync(false))" OnValidSubmit="(async () => await HandleSubmitAsync(true))">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h2>Is Test?</h2>
        <p>
            <label>
                Is Test?:
                <InputCheckbox @bind-Value="RomState.IsTest" @oninput="HandleIsTestChange"/>
            </label>
        </p>
        <h2>Name</h2>
        <p>
            <label>
                Name:
                <InputText @bind-Value="RomState.Name" @oninput="HandleNameChange"/>
            </label>
        </p>
        <h2>T</h2>
        <p>
            <label>
                T:
                <InputNumber @bind-Value="RomState.T" @oninput="HandleTChange"/>
            </label>
        </p>
        <h2>X</h2>
        <p>
            <label>
                X:
                <InputNumber @bind-Value="RomState.X" @oninput="HandleXChange"/>
            </label>
        </p>
        <h2>Y</h2>
        <p>
            <label>
                Y:
                <InputNumber @bind-Value="RomState.Y" @oninput="HandleYChange"/>
            </label>
        </p>
        <h2>Z</h2>
        <p>
            <label>
                Z:
                <InputNumber @bind-Value="RomState.Z" @oninput="HandleZChange"/>
            </label>
        </p>
        @* PropertyFormCodePlaceholder *@

        <br />
        <button type="button" disabled="@Busy" class="btn btn-warning" @onclick="CancelAsync">
            Cancel
        </button>&nbsp;
        <button disabled="@Busy" type="submit" class="btn btn-primary">
            Submit
        </button>
    </EditForm>
}

@code {
    [Parameter]
    public EventCallback<bool> ValidationResult { get; set; }

    [Parameter]
    public EventCallback CancelRequest { get; set; }

    [Parameter]
    public bool IsAdd { get; set; }

    [Parameter]
    public RomState? RomState { get; set; }

    [Parameter]
    public RomState? DbRomState { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    private string Mode => IsAdd ? "Add" : "Edit";

    @* DeclareListCodePlaceholder *@

    protected override void OnInitialized()
    {
        @* OnInitialCodePlaceholder *@
