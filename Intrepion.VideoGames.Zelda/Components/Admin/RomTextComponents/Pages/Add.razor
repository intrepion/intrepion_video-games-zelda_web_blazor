@page "/admin/rom-text/add"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Rom Text Add</PageTitle>

@if (RomText is not null)
{
  <RomTextForm Busy="Busy" 
         RomText="RomText" 
         IsAdd="true"
         CancelRequest="Cancel"
         ValidationResult="@(async (success) => await ValidationResultAsync(success))" />
}

@if (Success)
{
  <br />
  <div class="alert alert-success">The Rom Text was successfully added.</div>
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to add the Rom Text (@ErrorMessage).</div>
}

@code {
  private RomText? RomText { get; set; }

  private bool Busy;

  private bool Success;

  private bool Error;

  private string ErrorMessage = string.Empty;

  protected override void OnInitialized()
  {
    RomText = new();
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Success = false;
      Error = false;
      return;
    }

    Busy = true;

    using var context = DbFactory.CreateDbContext();

    if (RomText is not null)
    {
      context.RomTexts?.Add(RomText);
    }

    try
    {
      await context.SaveChangesAsync();
      Success = true;
      Error = false;

      Navigation.NavigateTo($"/admin/rom-text/view/{RomText?.Id}");
    }
    catch (Exception ex)
    {
      Success = false;
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel() => Navigation.NavigateTo($"/admin/rom-text");
}
