@page "/admin/rom-text/view/{RomTextId:guid}"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject EditSuccess EditSuccessState

<PageTitle>Rom Text View</PageTitle>

@if (NotFound && !Loading)
{
  <div class="alert alert-warning">Rom Text with that id doesn't exist.</div>
}
else
{
  @if (RomText is null || Loading)
  {
    <div class="alert alert-info">Loading...</div>
  }
  else
  {
    <h1>Rom Text Details</h1>
    <h6>ID: @RomText.Id</h6>
    @* PageHeaderCodePlaceholder *@

    <br />
    @if (EditSuccess)
    {
      <div class="alert alert-success">Successfully updated the Rom Text.</div>
    }
    <hr />

    <div class="container-fluid">
      <table class="table table-hover table-primary table-striped">
        <thead>
          <tr>
            <th>Property</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>ID</td>
            <td>@RomText.Id</td>
          </tr>
          <tr>
            <td>IsTest</td>
            <td>@RomText?.IsTest</td>
          </tr>
          <tr>
            <td>RomState</td>
            <td>@RomText?.RomState?.Name</td>
          </tr>
          <tr>
            <td>Text</td>
            <td>@RomText?.Text</td>
          </tr>
          @* ViewPropertyCodePlaceholder *@
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <a class="btn btn-primary" title="Go Back" href="admin/rom-text">
        Back to Grid
      </a>
      <span>&nbsp;</span>
      @if (!Deleted)
      {
        <a class="btn btn-primary" href="admin/rom-text/edit/@RomText.Id" title="Edit">Edit</a>

        <span>&nbsp;</span>
        @if (!ShowConfirmation)
        {
          <button class="btn btn-danger" @onclick="@(() => { ShowConfirmation = true; EditSuccess = false; })">Delete</button>
        }
        else
        {
          <br />
          <br />
          <DeletePrompt Confirmation="@(async result => await ConfirmAsync(result))" />
        }
      }
      else
      {
        <div class="btn btn-danger">🚫 This Rom Text has been deleted.</div>
      }
    </div>
  }
}

@code {
  private bool Loading;

  [Parameter]
  public Guid RomTextId { get; set; }

  private Guid _lastRomTextId;

  [Parameter]
  public bool EditSuccess { get; set; }

  private RomText? RomText { get; set; }

  private bool NotFound = false;

  private bool ShowConfirmation = false;

  private bool Deleted = false;

  protected override async Task OnParametersSetAsync()
  {
    if (_lastRomTextId != RomTextId)
    {
      EditSuccess = EditSuccessState.Success;
      EditSuccessState.Success = false;
      _lastRomTextId = RomTextId;
      await LoadRomTextAsync();
    }
  }

  private async Task ConfirmAsync(bool result)
  {
    if (result)
    {
      await DeleteAsync();
    }
    else
    {
      ShowConfirmation = false;
      EditSuccess = false;
    }
  }

  private async Task LoadRomTextAsync()
  {
    if (Loading)
    {
      return;
    }

    NotFound = false;
    RomText = null;

    Loading = true;

    using var context = DbFactory.CreateDbContext();

    if (context.RomTexts is not null)
    {
      RomText = await context.RomTexts
        .Include(x => x.RomState)
            @* TableIncludeCodePlaceholder *@
        @* .Include(x => x.Employee)
        .Include(x => x.Manager) *@
        .AsNoTracking()
        .SingleOrDefaultAsync(
          x => x.Id == RomTextId);

      if (RomText is null)
      {
        NotFound = true;
      }
    }

    Loading = false;
  }

  private async Task DeleteAsync()
  {
    if (Loading)
    {
      return;
    }

    Loading = true;
    using var context = DbFactory?.CreateDbContext();

    if (context?.RomTexts is not null)
    {
      var romText = await context.RomTexts
        .SingleOrDefaultAsync(x => x.Id == RomTextId);

      if (romText is not null)
      {
        context.RomTexts?.Remove(romText);
        await context.SaveChangesAsync();
        Loading = false;
        Deleted = true;
      }
      else
      {
        Loading = false;
        await LoadRomTextAsync();
      }
    }
    else
    {
      Loading = false;
      await LoadRomTextAsync();
    }
  }
}
