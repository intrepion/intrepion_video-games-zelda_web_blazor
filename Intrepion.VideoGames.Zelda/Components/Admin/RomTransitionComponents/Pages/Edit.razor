@page "/admin/rom-transition/edit/{RomTransitionId:guid}"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject EditSuccess EditSuccessState

<PageTitle>Rom Transition Edit</PageTitle>

@if (RomTransition is null && !Busy)
{
  <p>Could not find Rom Transition with id @RomTransitionId.</p>
}
else
{
  <RomTransitionForm Busy="Busy" 
         RomTransition="RomTransition" 
         DbRomTransition="DbRomTransition" 
         IsAdd="false" 
         CancelRequest="Cancel" 
         ValidationResult="@(async (success) => await ValidationResultAsync(success))" />
}

@if (ConcurrencyError)
{
  <br />
  <div class="alert alert-danger">
    <p>
      The Rom Transition details have changed since it was last loaded. The updated fields are highlighted in the form.
      Please choose an option:
    </p>
    <p><b>Cancel</b> to lose your changes and keep the database version.</p>
    <p><b>Submit</b> to force an update with your version.</p>
  </div>
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to update the Rom Transition (@ErrorMessage).</div>
}

@code {
  [Parameter]
  public Guid RomTransitionId { get; set; }

  private ApplicationDbContext? Context { get; set; }

  private RomTransition RomTransition { get; set; } = new RomTransition();

  private RomTransition DbRomTransition { get; set; } = new RomTransition();

  private bool Busy;

  private bool Error;

  private bool ConcurrencyError;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    Busy = true;

    try
    {
      Context = DbFactory.CreateDbContext();

      if (Context is not null && Context.RomTransitions is not null)
      {
        var romTransition = await Context.RomTransitions.SingleOrDefaultAsync(x => x.Id == RomTransitionId);

        if (romTransition is not null)
        {
          RomTransition = romTransition;
        }
      }
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Error = false;
      ConcurrencyError = false;
      return;
    }

    Busy = true;
    try
    {
      if (Context is not null)
      {
        await Context.SaveChangesAsync();
      }

      EditSuccessState.Success = true;
      Navigation.NavigateTo($"/admin/rom-transition/view/{RomTransition.Id}");
    }
    catch (DbUpdateConcurrencyException dbex)
    {
      EditSuccessState.Success = false;

      ConcurrencyError = true;

      var dbValues = dbex.Entries[0].GetDatabaseValues();

      if (dbValues is null)
      {
        Navigation.NavigateTo($"/admin/rom-transition/view/{RomTransition.Id}");
        return;
      }

      DbRomTransition = (RomTransition)dbValues.ToObject();

      dbex.Entries[0].OriginalValues.SetValues(dbValues);
      Error = false;
      Busy = false;
    }
    catch (Exception ex)
    {
      EditSuccessState.Success = false;
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel()
  {
    Busy = true;
    Navigation.NavigateTo($"/admin/rom-transition");
  }

  public void Dispose() => Context?.Dispose();
}
