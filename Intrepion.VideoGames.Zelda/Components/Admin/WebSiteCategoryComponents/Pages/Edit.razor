@page "/admin/web-site-category/edit/{WebSiteCategoryId:guid}"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject EditSuccess EditSuccessState

<PageTitle>WebSiteCategory Edit</PageTitle>

@if (WebSiteCategory is null && !Busy)
{
  <p>Could not find WebSiteCategory with id @WebSiteCategoryId.</p>
}
else
{
  <WebSiteCategoryForm Busy="Busy" 
         WebSiteCategory="WebSiteCategory" 
         DbWebSiteCategory="DbWebSiteCategory" 
         IsAdd="false" 
         CancelRequest="Cancel" 
         ValidationResult="@(async (success) => await ValidationResultAsync(success))" />
}

@if (ConcurrencyError)
{
  <br />
  <div class="alert alert-danger">
    <p>
      The WebSiteCategory details have changed since it was last loaded. The updated fields are highlighted in the form.
      Please choose an option:
    </p>
    <p><b>Cancel</b> to lose your changes and keep the database version.</p>
    <p><b>Submit</b> to force an update with your version.</p>
  </div>
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to update the WebSiteCategory (@ErrorMessage).</div>
}

@code {
  [Parameter]
  public Guid WebSiteCategoryId { get; set; }

  private ApplicationDbContext? Context { get; set; }

  private WebSiteCategory WebSiteCategory { get; set; } = new WebSiteCategory();

  private WebSiteCategory DbWebSiteCategory { get; set; } = new WebSiteCategory();

  private bool Busy;

  private bool Error;

  private bool ConcurrencyError;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    Busy = true;

    try
    {
      Context = DbFactory.CreateDbContext();

      if (Context is not null && Context.WebSiteCategories is not null)
      {
        var webSiteCategory = await Context.WebSiteCategories.SingleOrDefaultAsync(x => x.Id == WebSiteCategoryId);

        if (webSiteCategory is not null)
        {
          WebSiteCategory = webSiteCategory;
        }
      }
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Error = false;
      ConcurrencyError = false;
      return;
    }

    Busy = true;
    try
    {
      if (Context is not null)
      {
        await Context.SaveChangesAsync();
      }

      EditSuccessState.Success = true;
      Navigation.NavigateTo($"/admin/web-site-category/view/{WebSiteCategory.Id}");
    }
    catch (DbUpdateConcurrencyException dbex)
    {
      EditSuccessState.Success = false;

      ConcurrencyError = true;

      var dbValues = dbex.Entries[0].GetDatabaseValues();

      if (dbValues is null)
      {
        Navigation.NavigateTo($"/admin/web-site-category/view/{WebSiteCategory.Id}");
        return;
      }

      DbWebSiteCategory = (WebSiteCategory)dbValues.ToObject();

      dbex.Entries[0].OriginalValues.SetValues(dbValues);
      Error = false;
      Busy = false;
    }
    catch (Exception ex)
    {
      EditSuccessState.Success = false;
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel()
  {
    Busy = true;
    Navigation.NavigateTo($"/admin/web-site-category");
  }

  public void Dispose() => Context?.Dispose();
}
