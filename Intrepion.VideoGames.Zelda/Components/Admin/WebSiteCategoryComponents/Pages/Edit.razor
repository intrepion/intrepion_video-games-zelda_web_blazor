@page "/admin/web-site-category/add"
@page "/admin/web-site-category/edit/{WebSiteCategoryId:guid?}"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>WebSiteCategory @(IsAdd ? "Add" : "Edit")</PageTitle>

@if (WebSiteCategory is null && !Busy && !IsAdd)
{
  <p>Could not find WebSiteCategory with id @WebSiteCategoryId.</p>
}
else
{
    @* EmulatorList="EmulatorList" *@
  <WebSiteCategoryForm
    WebSiteList="WebSiteList"
    Busy="Busy" 
    CancelRequest="Cancel"
    DbWebSiteCategory="DbWebSiteCategory" 
    WebSiteCategory="WebSiteCategory" 
    IsAdd="IsAdd"
    ValidationResult="@(async (success) => await ValidationResultAsync(success))"
  />
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to @(IsAdd ? "add" : "update") the WebSiteCategory (@ErrorMessage).</div>
}

@code {
  [Parameter]
  public Guid? WebSiteCategoryId { get; set; }

  private bool IsAdd => WebSiteCategoryId == null;

  private ApplicationDbContext? Context { get; set; }

  private WebSiteCategory? WebSiteCategory { get; set; }

  private WebSiteCategory DbWebSiteCategory { get; set; } = new WebSiteCategory();

  private List<WebSite> WebSiteList { get; set; } = new List<WebSite>();
  @* ListDeclarationCodePlaceholder *@
  @* private List<Emulator> EmulatorList { get; set; } = new List<Emulator>();*@

  private bool Busy;

  private bool Error;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    Busy = true;

    try
    {
      Context = DbFactory.CreateDbContext();

      if (Context.WebSites != null)
      {
        WebSiteList = await Context.WebSites.ToListAsync();
      }
      @* LoadListCodePlaceholder *@
      @* if (Context.Emulators != null)
      {
        EmulatorList = await Context.Emulators.OrderBy(e => e.Name).ToListAsync();
      } *@

      if (IsAdd)
      {
        WebSiteCategory = new();
      }
      else if (Context is not null && Context.WebSiteCategories is not null)
      {
        var webSiteCategory = await Context.WebSiteCategories
            .Include(x => x.WebSite)
            @* IncludeListCodePlaceholder *@
            @* .Include(e => e.Emulator) *@
            .SingleOrDefaultAsync(x => x.Id == WebSiteCategoryId);

        if (webSiteCategory is not null)
        {
          WebSiteCategory = webSiteCategory;
        }
      }
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Error = false;
      return;
    }

    Busy = true;

    try
    {
      if (Context is not null && WebSiteCategory is not null)
      {
        @* SetExistingCodePlaceholder *@
        @* if (WebSiteCategory.Emulator != null && WebSiteCategory.Emulator.Id != Guid.Empty)
        {
          var existingEmulator = await Context.Emulators.FindAsync(WebSiteCategory.Emulator.Id);
          if (existingEmulator != null)
          {
            WebSiteCategory.Emulator = existingEmulator;
          }
        } *@
        
        if (IsAdd && Context.WebSiteCategories != null)
        {
          Context.WebSiteCategories.Add(WebSiteCategory);
        }
        
        await Context.SaveChangesAsync();
      }

      Navigation.NavigateTo($"/admin/web-site-category/view/{WebSiteCategory?.Id}");
    }
    catch (DbUpdateConcurrencyException dbex)
    {
      var dbValues = dbex.Entries[0].GetDatabaseValues();

      if (dbValues is null)
      {
        Navigation.NavigateTo($"/admin/web-site-category/view/{WebSiteCategory?.Id}");
        return;
      }

      DbWebSiteCategory = (WebSiteCategory)dbValues.ToObject();

      dbex.Entries[0].OriginalValues.SetValues(dbValues);
      Error = false;
      Busy = false;
    }
    catch (Exception ex)
    {
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel()
  {
    Busy = true;
    Navigation.NavigateTo($"/admin/web-site-category");
  }

  public void Dispose() => Context?.Dispose();
}
