@page "/admin/web-site/edit/{WebSiteId:guid}"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject EditSuccess EditSuccessState

<PageTitle>Web Site Edit</PageTitle>

@if (WebSite is null && !Busy)
{
  <p>Could not find Web Site with id @WebSiteId.</p>
}
else
{
  <WebSiteForm Busy="Busy" 
         WebSite="WebSite" 
         DbWebSite="DbWebSite" 
         IsAdd="false" 
         CancelRequest="Cancel" 
         ValidationResult="@(async (success) => await ValidationResultAsync(success))" />
}

@if (ConcurrencyError)
{
  <br />
  <div class="alert alert-danger">
    <p>
      The Web Site details have changed since it was last loaded. The updated fields are highlighted in the form.
      Please choose an option:
    </p>
    <p><b>Cancel</b> to lose your changes and keep the database version.</p>
    <p><b>Submit</b> to force an update with your version.</p>
  </div>
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to update the Web Site (@ErrorMessage).</div>
}

@code {
  [Parameter]
  public Guid WebSiteId { get; set; }

  private ApplicationDbContext? Context { get; set; }

  private WebSite WebSite { get; set; } = new WebSite();

  private WebSite DbWebSite { get; set; } = new WebSite();

  private bool Busy;

  private bool Error;

  private bool ConcurrencyError;

  private string ErrorMessage = string.Empty;

  protected override async Task OnInitializedAsync()
  {
    Busy = true;

    try
    {
      Context = DbFactory.CreateDbContext();

      if (Context is not null && Context.WebSites is not null)
      {
        var webSite = await Context.WebSites.SingleOrDefaultAsync(x => x.Id == WebSiteId);

        if (webSite is not null)
        {
          WebSite = webSite;
        }
      }
    }
    finally
    {
      Busy = false;
    }
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Error = false;
      ConcurrencyError = false;
      return;
    }

    Busy = true;
    try
    {
      if (Context is not null)
      {
        await Context.SaveChangesAsync();
      }

      EditSuccessState.Success = true;
      Navigation.NavigateTo($"/admin/web-site/view/{WebSite.Id}");
    }
    catch (DbUpdateConcurrencyException dbex)
    {
      EditSuccessState.Success = false;

      ConcurrencyError = true;

      var dbValues = dbex.Entries[0].GetDatabaseValues();

      if (dbValues is null)
      {
        Navigation.NavigateTo($"/admin/web-site/view/{WebSite.Id}");
        return;
      }

      DbWebSite = (WebSite)dbValues.ToObject();

      dbex.Entries[0].OriginalValues.SetValues(dbValues);
      Error = false;
      Busy = false;
    }
    catch (Exception ex)
    {
      EditSuccessState.Success = false;
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel()
  {
    Busy = true;
    Navigation.NavigateTo($"/admin/web-site");
  }

  public void Dispose() => Context?.Dispose();
}
