@page "/admin/web-site/view/{WebSiteId:guid}"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject EditSuccess EditSuccessState

<PageTitle>Web Site View</PageTitle>

@if (NotFound && !Loading)
{
  <div class="alert alert-warning">Web Site with that id doesn't exist.</div>
}
else
{
  @if (WebSite is null || Loading)
  {
    <div class="alert alert-info">Loading...</div>
  }
  else
  {
    <h1>Web Site Details</h1>
    <h6>ID: @WebSite.Id</h6>
    @* PageHeaderCodePlaceholder *@

    <br />
    @if (EditSuccess)
    {
      <div class="alert alert-success">Successfully updated the Web Site.</div>
    }
    <hr />

    <div class="container-fluid">
      <table class="table table-hover table-primary table-striped">
        <thead>
          <tr>
            <th>Property</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>ID</td>
            <td>@WebSite.Id</td>
          </tr>
          <tr>
            <td>IsTest</td>
            <td>@WebSite?.IsTest</td>
          </tr>
          <tr>
            <td>Name</td>
            <td>@WebSite?.Name</td>
          </tr>
          <tr>
            <td>Url</td>
            <td>@WebSite?.Url</td>
          </tr>
          @* ViewPropertyCodePlaceholder *@
        </tbody>
      </table>
    </div>

    <div class="mt-4">
      <a class="btn btn-primary" title="Go Back" href="admin/web-site">
        Back to Grid
      </a>
      <span>&nbsp;</span>
      @if (!Deleted)
      {
        <a class="btn btn-primary" href="admin/web-site/edit/@WebSite.Id" title="Edit">Edit</a>

        <span>&nbsp;</span>
        @if (!ShowConfirmation)
        {
          <button class="btn btn-danger" @onclick="@(() => { ShowConfirmation = true; EditSuccess = false; })">Delete</button>
        }
        else
        {
          <br />
          <br />
          <DeletePrompt Confirmation="@(async result => await ConfirmAsync(result))" />
        }
      }
      else
      {
        <div class="btn btn-danger">🚫 This Web Site has been deleted.</div>
      }
    </div>
  }
}

@code {
  private bool Loading;

  [Parameter]
  public Guid WebSiteId { get; set; }

  private Guid _lastWebSiteId;

  [Parameter]
  public bool EditSuccess { get; set; }

  private WebSite? WebSite { get; set; }

  private bool NotFound = false;

  private bool ShowConfirmation = false;

  private bool Deleted = false;

  protected override async Task OnParametersSetAsync()
  {
    if (_lastWebSiteId != WebSiteId)
    {
      EditSuccess = EditSuccessState.Success;
      EditSuccessState.Success = false;
      _lastWebSiteId = WebSiteId;
      await LoadWebSiteAsync();
    }
  }

  private async Task ConfirmAsync(bool result)
  {
    if (result)
    {
      await DeleteAsync();
    }
    else
    {
      ShowConfirmation = false;
      EditSuccess = false;
    }
  }

  private async Task LoadWebSiteAsync()
  {
    if (Loading)
    {
      return;
    }

    NotFound = false;
    WebSite = null;

    Loading = true;

    using var context = DbFactory.CreateDbContext();

    if (context.WebSites is not null)
    {
      WebSite = await context.WebSites
        @* TableIncludeCodePlaceholder *@
        @* .Include(x => x.Employee)
        .Include(x => x.Manager) *@
        .AsNoTracking()
        .SingleOrDefaultAsync(
          x => x.Id == WebSiteId);

      if (WebSite is null)
      {
        NotFound = true;
      }
    }

    Loading = false;
  }

  private async Task DeleteAsync()
  {
    if (Loading)
    {
      return;
    }

    Loading = true;
    using var context = DbFactory?.CreateDbContext();

    if (context?.WebSites is not null)
    {
      var webSite = await context.WebSites
        .SingleOrDefaultAsync(x => x.Id == WebSiteId);

      if (webSite is not null)
      {
        context.WebSites?.Remove(webSite);
        await context.SaveChangesAsync();
        Loading = false;
        Deleted = true;
      }
      else
      {
        Loading = false;
        await LoadWebSiteAsync();
      }
    }
    else
    {
      Loading = false;
      await LoadWebSiteAsync();
    }
  }
}
