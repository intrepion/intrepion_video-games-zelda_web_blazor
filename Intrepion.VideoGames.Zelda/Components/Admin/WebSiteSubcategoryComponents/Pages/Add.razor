@page "/admin/web-site-subcategory/add"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>WebSite Subcategory Add</PageTitle>

@if (WebSiteSubcategory is not null)
{
  <WebSiteSubcategoryForm Busy="Busy" 
         WebSiteSubcategory="WebSiteSubcategory" 
         IsAdd="true"
         CancelRequest="Cancel"
         ValidationResult="@(async (success) => await ValidationResultAsync(success))" />
}

@if (Success)
{
  <br />
  <div class="alert alert-success">The WebSite Subcategory was successfully added.</div>
}

@if (Error)
{
  <br />
  <div class="alert alert-danger">Failed to add the WebSite Subcategory (@ErrorMessage).</div>
}

@code {
  private WebSiteSubcategory? WebSiteSubcategory { get; set; }

  private bool Busy;

  private bool Success;

  private bool Error;

  private string ErrorMessage = string.Empty;

  protected override void OnInitialized()
  {
    WebSiteSubcategory = new();
  }

  private async Task ValidationResultAsync(bool success)
  {
    if (Busy)
    {
      return;
    }

    if (!success)
    {
      Success = false;
      Error = false;
      return;
    }

    Busy = true;

    using var context = DbFactory.CreateDbContext();

    if (WebSiteSubcategory is not null)
    {
      context.WebSiteSubcategories?.Add(WebSiteSubcategory);
    }

    try
    {
      await context.SaveChangesAsync();
      Success = true;
      Error = false;

      Navigation.NavigateTo($"/admin/web-site-subcategory/view/{WebSiteSubcategory?.Id}");
    }
    catch (Exception ex)
    {
      Success = false;
      Error = true;
      ErrorMessage = ex.Message;
      Busy = false;
    }
  }

  private void Cancel() => Navigation.NavigateTo($"/admin/web-site-subcategory");
}
