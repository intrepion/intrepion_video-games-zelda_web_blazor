@page "/admin/web-site-subcategory/view/{WebSiteSubcategoryId:guid}"
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject EditSuccess EditSuccessState

<PageTitle>WebSite Subcategory View</PageTitle>

@if (NotFound && !Loading)
{
  <div class="alert alert-warning">WebSite Subcategory with that id doesn't exist.</div>
}
else
{
  @if (WebSiteSubcategory is null || Loading)
  {
    <div class="alert alert-info">Loading...</div>
  }
  else
  {
    <h1>@WebSiteSubcategory.Id</h1>
        @* PageHeaderCodePlaceholder *@

    <br />
    @if (EditSuccess)
    {
      <div class="alert alert-success">Successfully updated the WebSite Subcategory.</div>
    }
    <hr />
    <h2>Id</h2>
    <br />
    <h3>@WebSiteSubcategory.Id</h3>
    <br />

    <h2>IsTest</h2>
        <br />
        <h3>@WebSiteSubcategory.IsTest</h3>
        <br />
        <h2>Name</h2>
        <br />
        <h3>@WebSiteSubcategory.Name</h3>
        <br />
        @* PropertyCodePlaceholder *@

    <a class="btn btn-primary" title="Go Back" href="admin/web-site-subcategory   ">
      Back to Grid
    </a>
    <span>&nbsp;</span>
    @if (!Deleted)
    {
      <a class="btn btn-primary" href="admin/web-site-subcategory/edit/@WebSiteSubcategory.Id" title="Edit">Edit</a>

      <span>&nbsp;</span>
      @if (!ShowConfirmation)
      {
        <button class="btn btn-danger" @onclick="@(() => { ShowConfirmation = true; EditSuccess = false; })">Delete</button>
      }
      else
      {
        <br />
        <br />
        <DeletePrompt Confirmation="@(async result => await ConfirmAsync(result))" />
      }
    }
    else
    {
      <div class="btn btn-danger">🚫 This WebSite Subcategory has been deleted.</div>
    }
  }
}

@code {
  private bool Loading;

  [Parameter]
  public Guid WebSiteSubcategoryId { get; set; }

  private Guid _lastWebSiteSubcategoryId;

  [Parameter]
  public bool EditSuccess { get; set; }

  private WebSiteSubcategory? WebSiteSubcategory { get; set; }

  private bool NotFound = false;

  private bool ShowConfirmation = false;

  private bool Deleted = false;

  protected override async Task OnParametersSetAsync()
  {
    if (_lastWebSiteSubcategoryId != WebSiteSubcategoryId)
    {
      EditSuccess = EditSuccessState.Success;
      EditSuccessState.Success = false;
      _lastWebSiteSubcategoryId = WebSiteSubcategoryId;
      await LoadWebSiteSubcategoryAsync();
    }
  }

  private async Task ConfirmAsync(bool result)
  {
    if (result)
    {
      await DeleteAsync();
    }
    else
    {
      ShowConfirmation = false;
      EditSuccess = false;
    }
  }

  private async Task LoadWebSiteSubcategoryAsync()
  {
    if (Loading)
    {
      return;
    }

    NotFound = false;
    WebSiteSubcategory = null;

    Loading = true;

    using var context = DbFactory.CreateDbContext();

    if (context.WebSiteSubcategories is not null)
    {
      WebSiteSubcategory = await context.WebSiteSubcategories
        .AsNoTracking()
        .SingleOrDefaultAsync(
          x => x.Id == WebSiteSubcategoryId);

      if (WebSiteSubcategory is null)
      {
        NotFound = true;
      }
    }

    Loading = false;
  }

  private async Task DeleteAsync()
  {
    if (Loading)
    {
      return;
    }

    Loading = true;
    using var context = DbFactory?.CreateDbContext();

    if (context?.WebSiteSubcategories is not null)
    {
      var webSiteSubcategory = await context.WebSiteSubcategories
        .SingleOrDefaultAsync(x => x.Id == WebSiteSubcategoryId);

      if (webSiteSubcategory is not null)
      {
        context.WebSiteSubcategories?.Remove(webSiteSubcategory);
        await context.SaveChangesAsync();
        Loading = false;
        Deleted = true;
      }
      else
      {
        Loading = false;
        await LoadWebSiteSubcategoryAsync();
      }
    }
    else
    {
      Loading = false;
      await LoadWebSiteSubcategoryAsync();
    }
  }
}
