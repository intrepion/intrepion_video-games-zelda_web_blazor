<h1>@Mode WebSiteSubcategory</h1>

<hr />
@if (WebSiteSubcategory is not null)
{
    <EditForm Model="WebSiteSubcategory" OnInvalidSubmit="(async () => await HandleSubmitAsync(false))" OnValidSubmit="(async () => await HandleSubmitAsync(true))">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Is Test?:
                <InputCheckbox @bind-Value="WebSiteSubcategory.IsTest" @oninput="HandleIsTestChange" class="form-check-input"/>
            </label>
        </div>
        <div class="mb-3">
            <label class="form-label">Name:
                <InputText @bind-Value="WebSiteSubcategory.Name" @oninput="HandleNameChange" class="form-control"/>
            </label>
        </div>
        <h2>Web Site</h2>
        <p>
            <label>
                Web Site:
                <InputSelect @bind-Value="SelectedWebSiteId" @oninput="HandleWebSiteChange" class="form-select">
                    <option value="">-- Select Web Site --</option>
                    @foreach (var webSite in WebSiteList)
                    {
                        <option value="@webSite.Id">@webSite?.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        <h2>Web Site Category</h2>
        <p>
            <label>
                Web Site Category:
                <InputSelect @bind-Value="SelectedWebSiteCategoryId" @oninput="HandleWebSiteCategoryChange" class="form-select">
                    <option value="">-- Select Web Site Category --</option>
                    @foreach (var webSiteCategory in WebSiteCategoryList)
                    {
                        <option value="@webSiteCategory.Id">@webSiteCategory?.Name</option>
                    }
                </InputSelect>
            </label>
        </p>
        @* PropertyFormCodePlaceholder *@

        <button type="button" disabled="@Busy" class="btn btn-warning" @onclick="CancelAsync">
            Cancel
        </button>&nbsp;
        <button disabled="@Busy" type="submit" class="btn btn-primary">
            Submit
        </button>
    </EditForm>
}

@code {
    [Parameter]
    public EventCallback<bool> ValidationResult { get; set; }

    [Parameter]
    public EventCallback CancelRequest { get; set; }

    [Parameter]
    public bool IsAdd { get; set; }

    [Parameter]
    public WebSiteSubcategory? WebSiteSubcategory { get; set; }

    [Parameter]
    public WebSiteSubcategory? DbWebSiteSubcategory { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    private string Mode => IsAdd ? "Add" : "Edit";

    [Parameter]
    public List<WebSite> WebSiteList { get; set; } = new List<WebSite>();
    private Guid SelectedWebSiteId;
    [Parameter]
    public List<WebSiteCategory> WebSiteCategoryList { get; set; } = new List<WebSiteCategory>();
    private Guid SelectedWebSiteCategoryId;
    @* DeclareListCodePlaceholder *@

    protected override void OnInitialized()
    {
        if (WebSiteSubcategory?.WebSite != null && !IsAdd)
        {
            SelectedWebSiteId = WebSiteSubcategory.WebSite.Id;
        }
        if (WebSiteSubcategory?.WebSiteCategory != null && !IsAdd)
        {
            SelectedWebSiteCategoryId = WebSiteSubcategory.WebSiteCategory.Id;
        }
        @* OnInitialCodePlaceholder *@
        @* if (EmulatorCore?.Emulator != null && !IsAdd)
        {
            SelectedEmulatorId = EmulatorCore.Emulator.Id;
        } *@
    }

    private async Task CancelAsync() => await CancelRequest.InvokeAsync(null);

    private async Task HandleSubmitAsync(bool isValid) => await ValidationResult.InvokeAsync(isValid);

    private void HandleIsTestChange(ChangeEventArgs changeEventArgs)
    {
        // SpecializedCodeIsTestPlaceholder
    }

    private void HandleNameChange(ChangeEventArgs changeEventArgs)
    {
        if (WebSiteSubcategory == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        WebSiteSubcategory.NormalizedName = ((string)changeEventArgs.Value).ToUpperInvariant();

        // SpecializedCodeNamePlaceholder
    }

    private void HandleWebSiteChange(ChangeEventArgs changeEventArgs)
    {
        if (WebSiteSubcategory == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        if (changeEventArgs.Value is string value && Guid.TryParse(value, out Guid selectedWebSiteId))
        {
            SelectedWebSiteId = selectedWebSiteId;
            var selectedWebSite = WebSiteList.FirstOrDefault(x => x.Id == SelectedWebSiteId);

            if (selectedWebSite != null)
            {
                WebSiteSubcategory.WebSite = selectedWebSite;
            }
        }

        // SpecializedCodeWebSitePlaceholder
    }

    private void HandleWebSiteCategoryChange(ChangeEventArgs changeEventArgs)
    {
        if (WebSiteSubcategory == null)
        {
            return;
        }

        if (changeEventArgs == null)
        {
            return;
        }

        if (changeEventArgs.Value == null)
        {
            return;
        }

        if (changeEventArgs.Value is string value && Guid.TryParse(value, out Guid selectedWebSiteCategoryId))
        {
            SelectedWebSiteCategoryId = selectedWebSiteCategoryId;
            var selectedWebSiteCategory = WebSiteCategoryList.FirstOrDefault(x => x.Id == SelectedWebSiteCategoryId);

            if (selectedWebSiteCategory != null)
            {
                WebSiteSubcategory.WebSiteCategory = selectedWebSiteCategory;
            }
        }

        // SpecializedCodeWebSiteCategoryPlaceholder
    }

    // HandleChangeCodePlaceholder
}
